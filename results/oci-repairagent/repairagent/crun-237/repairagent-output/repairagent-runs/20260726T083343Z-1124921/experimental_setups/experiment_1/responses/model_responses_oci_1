              "new_lines": [
                "static int",
                "set_loopback_up (libcrun_container_t *container, libcrun_error_t *err)",
                "{",
                "  struct ifreq ifr;",
                "  cleanup_close int fd = -1;",
                "  int ret;",
                "",
                "  /* Bring up loopback for freshly-created network namespaces.  Linux",
                "     creates lo in a new netns as DOWN, so network=none containers would",
                "     otherwise lose expected 127.0.0.1/loopback behavior.  */",
                "  if ((get_private_data (container)->unshare_flags & CLONE_NEWNET) == 0)",
                "    return 0;",
                "",
                "  fd = socket (AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);",

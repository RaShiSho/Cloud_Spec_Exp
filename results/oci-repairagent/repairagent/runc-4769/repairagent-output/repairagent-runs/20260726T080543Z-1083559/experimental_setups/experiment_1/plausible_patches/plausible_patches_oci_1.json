        "file_name": "libcontainer/specconv/spec_linux.go",
        "insertions": [
          {
            "line_number": 528,
            "new_lines": [
              "\t\t// Deduplicate supplemental groups while preserving their configured order.",
              "\t\t// Older runc releases collapsed duplicate additionalGids before applying setgroups,",
              "\t\t// so normalize the OCI list here before the process configuration is consumed.",
              "\t\tspec.Process.User.AdditionalGids = dedupeAdditionalGids(spec.Process.User.AdditionalGids)"
            ]
          },
          {
            "line_number": 576,
            "new_lines": [
              "func dedupeAdditionalGids(gids []uint32) []uint32 {",
              "\tif len(gids) < 2 {",
              "\t\treturn gids",
              "\t}",
              "",
              "\tseen := make(map[uint32]struct{}, len(gids))",
              "\tdeduped := gids[:0]",
              "\tfor _, gid := range gids {",
              "\t\tif _, ok := seen[gid]; ok {",
              "\t\t\tcontinue",
              "\t\t}",
              "\t\tseen[gid] = struct{}{}",
              "\t\tdeduped = append(deduped, gid)",
              "\t}",
              "\treturn deduped",
              "}",
              ""
            ]
          }
        ],
        "deletions": [],
        "modifications": []
      }
    ]
  }

          "file_name": "crates/libcontainer/src/syscall/linux.rs",
          "insertions": [
            {
              "line_number": 510,
              "new_lines": [
                "            CapSet::Ambient => {",
                "                // Ambient capabilities are controlled through prctl raise/drop operations,",
                "                // not the regular capset syscall used by caps::set for traditional sets.",
                "                // Reconcile the current ambient set with the OCI-requested set so CapAmb is applied.",
                "                let current = caps::read(None, CapSet::Ambient)?;",
                "                for c in current.difference(value) {",
                "                    caps::drop(None, CapSet::Ambient, *c)?;",
                "                }",
                "                for c in value.difference(&current) {",
                "                    caps::raise(None, CapSet::Ambient, *c)?;",
                "                }",
                "            }"
              ]
            }
          ],

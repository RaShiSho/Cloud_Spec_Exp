              "      /* Enable controllers in the parent before joining/creating the target cgroup.",
              "         On cgroup v2, limits for the target cgroup (for example memory.max) are",
              "         available only if the controller is enabled in the parent subtree_control.  */",
              "      {",
              "        cleanup_free char *parent_path = xstrdup (out->path);",
              "        char *parent = dirname (parent_path);",
              "",
              "        ret = enable_controllers (parent, err);",
              "        if (UNLIKELY (ret < 0))",
              "          return ret;",
              "      }",

              "  /* Enable cgroup v2 controllers in the parent before creating the container cgroup.",
              "     The kernel exposes memory.max for a child only when the memory controller is",
              "     enabled in the parent's cgroup.subtree_control, matching runc behavior for",
              "     OCI memory limits such as linux.resources.memory.limit.  */",
              "  {",
              "    cleanup_free char *parent_path = xstrdup (sub_path);",
              "    char *parent = dirname (parent_path);",
              "",
              "    ret = enable_controllers (parent, err);",
              "    if (UNLIKELY (ret < 0))",
              "      return ret;",
              "  }",
              ""
            ]

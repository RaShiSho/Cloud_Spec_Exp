c/libcrun/utils.h && sed -n '1,115p' src/libcrun/utils.c && git show --format= --no-ext-diff 620b91b5a076 -- src/libcrun/utils.c\"\n    }\n  }\n]\n```\nI found an ordering issue in the primary path: seccomp can be installed before OCI environment variables are applied. I\u2019m going to resolve the command after the container PATH is set but before seccomp, store the resolved path for the final `execv()`, and do the equivalent for `crun exec`.The primary path needs one additional ordering change: its early seccomp installation currently happens before the configured environment is applied. I\u2019m checking how the entrypoint argument struct is allocated so the resolved pathname can be stored and freed safely, then I\u2019ll make the one-file edit.```json\n[\n  {\n    \"command_name\": \"Terminal.run_command\",\n    \"args\": {\n      \"cmd\": \"cd /home/aludy/scires/Cloud_Spec_Exp/external/worktrees/framework-smoke-20261001/metagpt/crun-13 && rg -n -C 7 'container_entrypoint_s|entrypoint_args|libcrun_generate_and_load_seccomp' src/libcrun/container.c | head -230 && sed -n '490,585p' src/libcrun/container.c && sed -n '900,1040p' src/libcrun/container.c\"\n    }\n  }\n]\n```\nThe implementation point is now clear: the command must be resolved while the container root and OCI environment are active, before the device seccomp filter is loaded. I\u2019ll add a local resolver that preserves direct paths, searches the configured `PATH`, and records the first permission error while continuing to search later entries.```json\n[\n  {\n    \"command_name\": \"Editor.open_file\",\n    \"args\": {\n      \"path\": \"/home/aludy/scires/Cloud_Spec_Exp/external/worktrees/framework-smoke-20261001/metagpt/crun-13/src/libcrun/container.c\",\n      \"line_number\": 40,\n      \"context_lines\": 80\n    }\n  }\n]\n```\n I\u2019m making a focused edit to `src/libcrun/container.c`: resolve `args[0]` while the container PATH and root filesystem are active, before the startup seccomp filter, retain that resolved path in the entrypoint state, and use `execv()` at launch. The `crun exec` path will resolve after applying its process environment and before its seccomp filter.```json\n[\n  {\n    \"command_name\": \"Terminal.run_command\",\n    \"args\": {\n      \"cmd\": \"cd /home/aludy/scires/Cloud_Spec_Exp/external/worktrees/framework-smoke-20261001/metagpt/crun-13 && apply_patch <<'PATCH'\\n*** Begin Patch\\n*** Update File: src/libcrun/container.c\\n@@\\n struct container_entrypoint_s\\n {\\n@@\\n   int seccomp_fd;\\n   int console_socket_fd;\\n+  char *executable_path;\\n };\\n+\\n+static char *\\n+find_executable (const char *executable)\\n+{\\n+  const char *path, *entry;\\n+  int saved_errno = ENOENT;\\n+\\n+  if (strchr (executable, '/'))\\n+    {\\n+      if (access (executable, X_OK) == 0)\\n+        return xstrdup (executable);\\n+      return NULL;\\n+    }\\n+\\n+  path = getenv (\\\"PATH\\\");\\n+  if (path == NULL)\\n+    path = \\\"/bin:/usr/bin\\\";\\n+\\n+  entry = path;\\n+  do\\n+    {\\n+      const char *end = strchr (entry, ':');\\n+      size_t dir_len = end ? (size_t) (end - entry) : strlen (entry);\\n+      size_t executable_len = strlen (executable);\\n+      size_t candidate_len = dir_len + (dir_len ? 1 : 0) + executable_len;\\n+      char *candidate = xmalloc (candidate_len + 1);\\n+      int ret;\\n+\\n+      if (dir_len)\\n+        {\\n+          memcpy (candidate, entry, dir_len);\\n+          candidate[dir_len] = '/';\\n+          memcpy (candidate + dir_len + 1, executable, executable_len + 1);\\n+        }\\n+      else\\n+        memcpy (candidate, executable, executable_len + 1);\\n+\\n+      ret = access (candidate, X_OK);\\n+      if (ret == 0)\\n+        return candidate;\\n+      if (errno == EACCES)\\n+        saved_errno = EACCES;\\n+      free (candidate);\\n+\\n+      if (end == NULL)\\n+        break;\\n+      entry = end + 1;\\n+    }\\n+  while (1);\\n+\\n+  errno = saved_errno;\\n+  return NULL;\\n+}\\n@@\\n   if (def->process && def->process->no_new_privileges)\\n@@\\n   if (! def->process)\\n     return crun_make_error (err, errno, \\\"block 'process' not found\\\");\\n \\n-  execvp (def->process->args[0], def->process->args);\\n+  entrypoint_args->executable_path = find_executable (def->process->args[0]);\\n+  if (entrypoint_args->executable_path == NULL)\\n+    return crun_make_error (err, errno, \\\"executable file not found in $PATH\\\");\\n+\\n+  execv (entrypoint_args->executable_path, def->process->args);\\n@@\\n       for (i = 0; i < process->env_len; i++)\\n         if (putenv (process->env[i]) < 0)\\n           libcrun_fail_with_error ( errno, \\\"putenv '%s'\\\", process->env[i]);\\n+\\n+      char *executable_path = find_executable (process->args[0]);\\n+      if (executable_path == NULL)\\n+        libcrun_fail_with_error (errno, \\\"executable file not found in $PATH\\\");\\n@@\\n-      execvp (process->args[0], process->args);\\n+      execv (executable_path, process->args);\\n*** End Patch\\nPATCH\\n\"}\n  }\n]\n```\nThe first patch needs an ordering correction: in the normal startup path, it still resolves the executable after seccomp has been loaded. I\u2019m moving that lookup to the point after the OCI environment is installed and before seccomp, and tightening explicit-path handling so `execv()` remains responsible for its original errors.The first edit exposed an ordering mistake: normal startup still performs PATH lookup after an early seccomp load. I\u2019ll correct that placement, preserve direct-path `execv()` errors, and verify the diff before building.```json\n[\n  {\n    \"command_name\": \"Terminal.run_command\",\n    \"args\": {\n      \"cmd\": \"cd /home/aludy/scires/Cloud_Spec_Exp/external/worktrees/framework-smoke-20261001/metagpt/crun-13 && apply_patch <<'PATCH'\\n*** Begin Patch\\n*** Update File: src/libcrun/container.c\\n@@\\n   if (strchr (executable, '/'))\\n-    {\\n-      if (access (executable, X_OK) == 0)\\n-        return xstrdup (executable);\\n-      return NULL;\\n-    }\\n+    return xstrdup (executable);\\n+\\n+  if (executable[0] == '\\\\0')\\n+    {\\n+      errno = ENOENT;\\n+      return NULL;\\n+    }\\n@@\\n       ret = access (candidate, X_OK);\\n       if (ret == 0)\\n-        return candidate;\\n+        {\\n+          struct stat st;\\n+          if (stat (candidate, &st) == 0 && !S_ISDIR (st.st_mode))\\n+            return candidate;\\n+          if (S_ISDIR (st.st_mode))\\n+            saved_errno = EACCES;\\n+        }\\n@@\\n-  if (def->process && !def->process->no_new_privileges)\\n-    {\\n-      ret = libcrun_generate_and_load_seccomp (entrypoint_args->container, entrypoint_args->seccomp_fd, err);\\n-      if (UNLIKELY (ret < 0))\\n-        return ret;\\n-    }\\n-\\n   capabilities = def->process ? def->process->capabilities : NULL;\\n@@\\n   if (notify_socket)\\n@@\\n       if (putenv (notify_socket_env) < 0)\\n         return crun_make_error (err, errno, \\\"putenv '%s'\\\", notify_socket_env);\\n     }\\n+\\n+  if (def->process)\\n+    {\\n+      entrypoint_args->executable_path = find_executable (def->process->args[0]);\\n+      if (entrypoint_args->executable_path == NULL)\\n+        return crun_make_error (err, errno, \\\"executable file not found in $PATH\\\");\\n+\\n+      if (!def->process->no_new_privileges)\\n+        {\\n+          ret = libcrun_generate_and_load_seccomp (container, entrypoint_args->seccomp_fd, err);\\n+          if (UNLIKELY (ret < 0))\\n+            return ret;\\n+        }\\n+    }\\n@@\\n-  entry",

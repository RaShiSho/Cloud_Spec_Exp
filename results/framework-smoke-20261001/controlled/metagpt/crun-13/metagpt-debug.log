+            return candidate;
+          if (S_ISDIR (st.st_mode))
+            saved_errno = EACCES;
+        }
+      if (errno == EACCES)
+        saved_errno = EACCES;
+      free (candidate);
+
+      if (end == NULL)
+        break;
+      entry = end + 1;
+    }
+  while (1);
+
+  errno = saved_errno;
+  return NULL;
+}

+static char *
+find_executable (const char *executable)
+{
+  const char *path, *entry;
+  int saved_errno = ENOENT;
+
+  if (strchr (executable, '/'))
+    return xstrdup (executable);
+
+  if (executable[0] == '\0')
+    {
+      errno = ENOENT;
+      return NULL;
+    }
+
+  path = getenv ("PATH");
+  if (path == NULL)
+    path = "/bin:/usr/bin";
+
+  entry = path;
+  do
+    {
+      const char *end = strchr (entry, ':');
+      size_t dir_len = end ? (size_t) (end - entry) : strlen (entry);
+      size_t executable_len = strlen (executable);
+      size_t candidate_len = dir_len + (dir_len ? 1 : 0) + executable_len;
+      char *candidate = xmalloc (candidate_len + 1);
+      int ret;
+
+      if (dir_len)
+        {
+          memcpy (candidate, entry, dir_len);
+          candidate[dir_len] = '/';
+          memcpy (candidate + dir_len + 1, executable, executable_len + 1);
+        }
+      else
+        memcpy (candidate, executable, executable_len + 1);
+
+      ret = access (candidate, X_OK);
+      if (ret == 0)
+        {
+          struct stat st;
+          if (stat (candidate, &st) == 0 && !S_ISDIR (st.st_mode))
+            return candidate;
+          if (S_ISDIR (st.st_mode))
+            saved_errno = EACCES;
+        }
+      if (errno == EACCES)
+        saved_errno = EACCES;
+      free (candidate);
+
+      if (end == NULL)
+        break;
+      entry = end + 1;
+    }
+  while (1);
+
+  errno = saved_errno;
+  return NULL;
+}

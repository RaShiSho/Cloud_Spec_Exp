# Copy this file to .env and fill real values.

# Only credentials live here. Model IDs, endpoints, and sampling parameters
# belong in configs/model_profiles.yaml. Experiments select model_profile.
# A value set here and in the shell must agree; conflicting values are errors.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GATEWAY_API_KEY=

# Optional pip mirror settings for WSL setup.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_DEFAULT_TIMEOUT=120
